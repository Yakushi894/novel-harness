# すべて任意（上級者向け）。通常は Web UI の「設定」画面で設定すればよい。
# 環境変数は「初期値」として使われ、設定画面の値が優先される。

# 推論サーバー（XeStrata）の OpenAI 互換API
STRATA_BASE_URL=http://192.168.1.10:8080
# LAN 内でキー不要な構成なら空でよい
STRATA_API_KEY=

# 2次修正モデルの目印（ロード中モデルIDに含まれる文字列。空＝モデル変更そのもので判定）
MODEL_Q4_HINT=

# Synology Chat の Incoming Webhook URL（未設定なら通知はログのみ）
CHAT_WEBHOOK_URL=

# UI トークン（空なら認証なし。LAN 内のみの利用なら空でもよい）
UI_TOKEN=

# 生成パラメータの初期値（設定画面で変更可能）
CTX_WINDOW=65536
MAX_TOKENS_CHAPTER=16384
MAX_TOKENS_REVISE=32768

# 検証用モック
MOCK_LLM=0
